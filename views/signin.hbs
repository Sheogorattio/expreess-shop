<form class="container mt-5" action="/signin" method="POST">
  <div class="form-group mb-3">
    <label for="signinEmail">Email address</label>
    <input type="email" class="form-control" id="signinEmail" name="email" placeholder="Enter email" required>
  </div>
  <div class="form-group mb-3">
    <label for="signinPassword">Password</label>
    <input type="password" class="form-control" id="signinPassword" name="password" placeholder="Enter password" required>
  </div>
  <button type="submit" class="btn btn-primary">Sign In</button>
  <p class="mt-3">Don't have an account? <a href="/signup">Sign up here</a>.</p>
</form>
